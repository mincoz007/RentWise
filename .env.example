GOOGLE_CLIENT_ID=your-google-oauth-client-id
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
GOOGLE_REDIRECT_URI=http://localhost:5175/api/auth/google/callback
# Create a database and login role in pgAdmin 4, then use that database here.
# URL-encode reserved characters in the password (for example @ becomes %40).
DATABASE_URL=postgresql://rentwise_app:change_this_password@localhost:5432/rentwise
# Production API bind settings. Keep 127.0.0.1 behind an HTTPS reverse proxy.
HOST=127.0.0.1
PORT=3000
# Optional: set to require when connecting to a TLS-enabled PostgreSQL server.
# PGSSLMODE=require

# Optional automatic WhatsApp rent reminders.
# Create and approve a WhatsApp Utility template whose body contains one {{1}} text variable.
# Keep the access token private on the server; never add it to VITE_ variables.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_GRAPH_API_VERSION=v25.0
# Test-template settings from Meta's no-variable sample template; use the exact name/language in your WABA.
WHATSAPP_TEST_TEMPLATE_NAME=jaspers_market_plain_text_v1
WHATSAPP_TEST_TEMPLATE_LANGUAGE=en_US
WHATSAPP_REMINDER_TEMPLATE_NAME=rentwise_rent_reminder
WHATSAPP_REMINDER_TEMPLATE_LANGUAGE=en_US
RENTWISE_REMINDER_TIMEZONE=Africa/Lagos

# Optional RentWise plan subscriptions. Keep the secret key server-side; never use a VITE_ prefix.
# Paystack test keys are available from the Paystack dashboard. Configure a live key only when ready to collect real payments.
PAYSTACK_SECRET_KEY=
# Paystack webhook signing secret/key. Keep this server-side; configure a public webhook URL in Paystack.
PAYSTACK_WEBHOOK_SECRET=
# Required for production checkout; use the public HTTPS site origin (for example https://rentwise.example.com).
RENTWISE_PUBLIC_URL=

# Self-service signup verification and password recovery use Resend.
# Verify the sender domain in Resend before using this in production.
RESEND_API_KEY=
RENTWISE_EMAIL_FROM=RentWise NG <accounts@your-verified-domain.example>
