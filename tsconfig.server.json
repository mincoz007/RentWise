{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": ["node"],
    "skipLibCheck": true,
    "verbatimModuleSyntax": true,
    "rewriteRelativeImportExtensions": true,
    "rootDir": ".",
    "outDir": "dist-server",
    "sourceMap": true,
    "noEmit": false,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["server/**/*.ts", "src/plan-catalog.ts"]
}
